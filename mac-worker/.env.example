# Copy to a private local .env and replace paths/token. No weights download at runtime.
MI_DATA_DIR=./data/mac-worker
MI_BIND_HOST=127.0.0.1
MI_BIND_PORT=8765
MI_API_TOKEN=replace-with-a-random-token-of-at-least-32-characters
MI_ALLOWED_ORIGINS=https://192.168.8.57,https://radxa-cubie-a7a.local
# Mandatory when MI_BIND_HOST is a LAN address; provision these private files first.
MI_TLS_CERT_FILE=/absolute/path/to/worker-pki/worker.crt
MI_TLS_KEY_FILE=/absolute/path/to/worker-pki/worker.key
MI_TLS_CLIENT_CA_FILE=/absolute/path/to/worker-pki/ca.crt
MI_OLLAMA_URL=http://127.0.0.1:11434
MI_OLLAMA_MODEL=qwen3.5:4b
MI_OLLAMA_CONTEXT=32768
MI_OLLAMA_TIMEOUT=600
MI_ASR_KK_RU=whisper-cpp
MI_ASR_EN=whisper-cpp
MI_WHISPER_BINARY=/absolute/path/to/whisper-cli
MI_WHISPER_MODEL=/absolute/path/to/ggml-large-v3.bin
MI_WHISPER_MODEL_EN=/absolute/path/to/ggml-large-v3-turbo-q5_0.bin
MI_WHISPER_VAD_MODEL=/absolute/path/to/ggml-silero-v6.2.0.bin
MI_FFMPEG_BINARY=/absolute/path/to/ffmpeg
MI_ENABLE_DIARIZATION=true
MI_DIARIZATION_BACKEND=sherpa-onnx
MI_SEGMENTATION_MODEL=/absolute/path/to/sherpa-onnx-pyannote-segmentation-3-0/model.onnx
MI_EMBEDDING_MODEL=/absolute/path/to/nemo_en_titanet_small.onnx
MI_PDF_FONT=/System/Library/Fonts/Supplemental/Arial.ttf
MI_HF_OFFLINE=true
MI_SEMANTIC_VERIFICATION=true
MI_MAX_UPLOAD_BYTES=536870912
MI_MAX_AUDIO_SECONDS=14400
MI_AUDIO_TIMEOUT=1800
# Optional provisioned local model directories; these profiles are not the demo defaults.
# MI_ASR_KK_RU=shyngys
# MI_SHYNGYS_MODEL=/absolute/path/to/shyngys-whisper-model
# MI_ASR_EN=mlx-distil-whisper
# MI_DISTIL_MODEL=/absolute/path/to/mlx-distil-whisper
# MI_GIGAAM_MODEL=/absolute/path/to/gigaam-model
