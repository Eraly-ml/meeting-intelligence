MI_STATION_TOKEN=replace-with-a-long-random-station-token
MI_STATION_WORKER_TOKEN=replace-with-the-mac-MI_API_TOKEN
MI_STATION_WORKER_URL=https://192.168.1.42:8765
MI_STATION_WORKER_CA_FILE=/etc/meeting-intelligence/tls/ca.crt
MI_STATION_WORKER_CERT_FILE=/etc/meeting-intelligence/tls/station.crt
MI_STATION_WORKER_KEY_FILE=/etc/meeting-intelligence/tls/station.key
MI_STATION_DATA_DIR=/var/lib/meeting-station
MI_STATION_BIND_HOST=127.0.0.1
MI_STATION_BIND_PORT=8766
MI_STATION_MAX_UPLOAD_BYTES=536870912
MI_STATION_ALSA_DEVICE=default
# Optional isolated meeting browser; must match its private MI_BROWSER_TOKEN.
# Leave token empty to disable browser control while keeping uploads available.
MI_STATION_BROWSER_URL=http://127.0.0.1:8770
MI_STATION_BROWSER_TOKEN=
