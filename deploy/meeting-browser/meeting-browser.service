[Unit]
Description=Isolated ARM64 meeting browser
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/meeting-browser/provisioned

[Service]
Type=simple
RootDirectory=/opt/meeting-browser/rootfs
MountAPIVFS=yes
User=meeting-browser
Group=meeting-browser
WorkingDirectory=/var/lib/meeting-browser
EnvironmentFile=/opt/meeting-browser/browser.env
RuntimeDirectory=meeting-browser
RuntimeDirectoryMode=0700
BindPaths=/run/meeting-browser
BindPaths=/var/lib/meeting-browser
BindReadOnlyPaths=/etc/resolv.conf
ExecStart=/opt/meeting-browser/launch.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
