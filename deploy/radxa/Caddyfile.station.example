# Direct LAN access for clients without mDNS or the board's local CA installed.
# Restrict this entry point to the private demo LAN. Its traffic is unencrypted.
# Update the literal address and Scriberr ALLOWED_ORIGINS if its DHCP lease changes.
http://192.168.8.57 {
	encode zstd gzip
	header {
		-Server
		X-Robots-Tag "noindex, nofollow, noarchive"
	}
	handle_path /api/meeting-worker/* {
		reverse_proxy 127.0.0.1:8766
	}
	handle {
		reverse_proxy 127.0.0.1:8081 {
			# Go retains SECURE_COOKIES=true for the HTTPS entry point below.
			# Allow this HTTP origin to retain its own login/refresh cookie.
			header_down Set-Cookie "(?i);[[:space:]]*Secure(;|$)" "$1"
		}
	}
}

# Keep the board's existing hostname and Caddy local certificate authority.
http:// {
	redir https://radxa-cubie-a7a.local{uri} permanent
}

radxa-cubie-a7a.local {
	tls internal
	encode zstd gzip
	header {
		-Server
		X-Robots-Tag "noindex, nofollow, noarchive"
	}
	handle_path /api/meeting-worker/* {
		reverse_proxy 127.0.0.1:8766
	}
	handle {
		reverse_proxy 127.0.0.1:8081
	}
}
