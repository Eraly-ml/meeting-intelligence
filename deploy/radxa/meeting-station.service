[Unit]
Description=Meeting Intelligence archive and Mac worker bridge
After=network-online.target
Wants=network-online.target

[Service]
User=meeting-station
Group=meeting-station
SupplementaryGroups=audio
WorkingDirectory=/var/lib/meeting-station
EnvironmentFile=/etc/meeting-intelligence/station.env
ExecStart=/opt/meeting-intelligence/venv/bin/meeting-station
Restart=on-failure
RestartSec=3
StateDirectory=meeting-station
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/meeting-station
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
